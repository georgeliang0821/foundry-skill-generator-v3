# Microsoft Foundry project
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_AGENT_NAME=skill-generator-agent
FOUNDRY_AGENT_VERSION=2

# Microsoft Entra sign-in
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_OBO_SCOPE=api://your-app-id/user_impersonation

# Foundry + Azure SQL service principal (AZURE_* is also read by DefaultAzureCredential)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure Blob storage
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
AZURE_BLOB_CONTAINER=skills

# EAA MCP root. REQUIRED to save: saving calls its lint_skill_package tool and is
# refused when no verdict comes back.
MCP_ENDPOINT=
# Only when the MCP server validates a different audience than MICROSOFT_OBO_SCOPE
MCP_OAUTH_AUDIENCE=

# Local development defaults
SGV2_SESSION_DIR=./.sessions
SGV2_SESSION_STORE=local
SGV2_AUTH_STORE=local

# ---- Optional features (docs/02-setup.md section 5) ----

# Selection-test route runner: any HTTP endpoint implementing the /run contract.
SKILL_SELECTION_TEST_RUN_URL=

# ACA inspection and script-form skills: enabled only when MCP_ENDPOINT and all
# three below are set.
ACA_APP_NAME=
ACA_RESOURCE_GROUP=
ACA_SUBSCRIPTION_ID=

# Multi-instance deployments: set SGV2_SESSION_STORE and SGV2_AUTH_STORE to 'blob'.
# The blob settings below default to the AZURE_* storage account/container above.
# SGV2_SESSION_BLOB_CONTAINER=
# SGV2_SESSION_BLOB_PREFIX=sessions
# SGV2_AUTH_STORAGE_ACCOUNT_URL=
# SGV2_AUTH_STORAGE_CONNECTION_STRING=
# SGV2_AUTH_BLOB_CONTAINER=
# SGV2_AUTH_BLOB_PREFIX=auth
